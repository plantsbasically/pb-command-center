# Shopify — prefer client credentials (Dev Dashboard app: PB Agents API)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_DOMAIN=plantsbasically.myshopify.com

# Fallback store host if SHOPIFY_STORE_DOMAIN is unset (https:// and trailing / optional)
# SHOPIFY_STORE_URL=plantsbasically.myshopify.com

# Legacy static Admin API token (used only when client id/secret are unset)
# SHOPIFY_ACCESS_TOKEN=

# Other integrations
TRIPLEWHALE_API_KEY=
LOOP_API_KEY=
# Bearer secret for POST /api/loop-metrics/ingest + GET /api/loop-metrics/status
LOOP_INGEST_SECRET=

# Bearer secret for POST/GET /api/daily-metrics/refresh (cron + backfill)
DAILY_METRICS_CRON_SECRET=
# Set to 0 to disable in-process 12m ticker (use Railway cron only)
# DAILY_METRICS_INPROCESS_SCHEDULER=0

# Time-to-second-order cache refresh (POST/GET /api/second-order/refresh)
# Falls back to DAILY_METRICS_CRON_SECRET when unset
# SECOND_ORDER_CRON_SECRET=
# SHOPIFY_SECOND_ORDER_LOOKBACK_DAYS=180

# ShipFusion billing (primary 3PL fulfillment cost)
# Auth: X-SHIPFUSION-TOKEN (OpenAPI); Bearer fallback if needed
SHIPFUSION_API_KEY=
# SHIPFUSION_API_TOKEN=

# Railway Postgres
# DATABASE_URL=
