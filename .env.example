# Shopify — prefer client credentials (Dev Dashboard app: PB Agents API)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_DOMAIN=plantsbasically.myshopify.com

# Fallback store host if SHOPIFY_STORE_DOMAIN is unset (https:// and trailing / optional)
# SHOPIFY_STORE_URL=plantsbasically.myshopify.com

# Legacy static Admin API token (used only when client id/secret are unset)
# SHOPIFY_ACCESS_TOKEN=

# Other integrations
TRIPLEWHALE_API_KEY=
LOOP_API_KEY=
